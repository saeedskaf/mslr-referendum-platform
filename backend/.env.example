# ───────────────────────────────────────────────
#  MSLR backend — environment configuration
#
#  Copy this file to `.env` and fill in real values:
#      cp .env.example .env
#
#  `.env` is git-ignored and must never be committed.
#  If a variable is omitted, the development default in settings.py is used,
#  so the project still runs out of the box for local development.
# ───────────────────────────────────────────────

# ── Core Django ──
# Generate a fresh key for production, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Never run with DEBUG enabled in production.
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts, e.g. example.com,api.example.com
DJANGO_ALLOWED_HOSTS=*

# Allow all CORS origins (True for dev). Disable and configure explicitly in prod.
DJANGO_CORS_ALLOW_ALL=True

# ── JWT ──
# Optional. Defaults to DJANGO_SECRET_KEY if unset.
JWT_SIGNING_KEY=

# ── Election Commission credentials ──
# Override these before deploying.
EC_EMAIL=ec@referendum.gov.sr
EC_PASSWORD=change-me-to-a-strong-password
EC_API_TOKEN=change-me-to-a-random-token
